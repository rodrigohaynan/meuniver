NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_APENAS_NO_SERVIDOR

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Convidata

# Aplicação criada no Mercado Pago Developers.
# Nunca use CLIENT_SECRET no navegador.
MERCADO_PAGO_CLIENT_ID=SEU_APP_ID
MERCADO_PAGO_CLIENT_SECRET=SEU_CLIENT_SECRET

# Cobrança da publicação (organizador paga PIX direto para a Convidata).
# Access token de PRODUÇÃO da conta Mercado Pago da própria Convidata.
# Só é necessário quando "Cobrar por novos convites" estiver ativo no admin.
MERCADO_PAGO_PLATFORM_ACCESS_TOKEN=
